# Example Nginx reverse proxy config for a single VPS running both services via
# docker-compose (see docker-compose.yml — backend on 127.0.0.1:8000, frontend on
# 127.0.0.1:3000). Copy to /etc/nginx/sites-available/your-domain, adjust
# server_name, symlink into sites-enabled, then run certbot for HTTPS:
#
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/your-domain
#   sudo ln -s /etc/nginx/sites-available/your-domain /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d your-domain.com -d api.your-domain.com

# Frontend (Next.js dashboard) — e.g. your-domain.com
server {
    listen 80;
    server_name your-domain.com;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Backend (FastAPI) — e.g. api.your-domain.com
server {
    listen 80;
    server_name api.your-domain.com;

    client_max_body_size 30M;  # allow uploads a bit over MAX_UPLOAD_MB

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
